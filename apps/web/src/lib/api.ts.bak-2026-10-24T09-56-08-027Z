export async function organizationStructure(secretariatId?: string): Promise<OrgStructureSnapshot> {
  const payload = secretariatId ? { secretariatId } : {};
  const data = await workflow('ORG_STRUCTURE_SNAPSHOT', payload);
  return {
    secretariat: data?.secretariat ?? null,
    secretary: data?.secretary ?? null,
    bodies: Array.isArray(data?.bodies) ? data.bodies : [],
    positions: Array.isArray(data?.positions) ? data.positions : [],
    memberships: Array.isArray(data?.memberships) ? data.memberships : [],
    appointments: Array.isArray(data?.appointments) ? data.appointments : [],
  } as OrgStructureSnapshot;
}

